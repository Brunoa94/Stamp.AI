{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/route.ts",
    "supabase/functions/**/index.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "supabase/**/*.ts"],
  "ignore": [
    "**/*.test.ts",
    "src/types/**",
    "supabase/types/**",
    "playwright.config.ts"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "@ai-hero/sandcastle",
    "@testing-library/react",
    "@testing-library/user-event"
  ],
  "next": {
    "entry": [
      "next.config.{js,ts,mjs}",
      "src/app/**/page.tsx",
      "src/app/**/layout.tsx",
      "src/app/**/route.ts",
      "src/app/api/**/*.ts",
      "src/middleware.ts"
    ]
  }
}
