// Cloudflare Worker that serves the site's raster images from the R2 bucket
// `stamp-static-assets` at https://stamp-static-assets.<account>.workers.dev.
// R2 has no egress fees, so image traffic no longer counts against Supabase.
// One-time setup: `npx wrangler@4 login`, `npx wrangler@4 r2 bucket create stamp-static-assets`,
// then `npx wrangler@4 deploy` from this folder. Fill the bucket with
// scripts/push-static-assets.mjs --target r2 and set NEXT_PUBLIC_STATIC_ASSETS_URL to the Worker URL.
{
  "name": "stamp-static-assets",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "stamp-static-assets" }]
}
