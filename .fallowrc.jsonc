{
  "$schema": "./node_modules/fallow/schema.json",
  // Generated, vendored and tooling output that isn't ours to deduplicate.
  "ignorePatterns": [
    ".claude/**",
    "src/types/database.types.ts",
    "src/shared/types/database.types.ts",
    "database.types.ts",
    "supabase/types/**",
    ".sandcastle/**",
    ".acceptance/**",
    ".superdesign/**",
    "playwright/**"
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    // Ratchet: fail once duplication grows past today's level (6.8% on 2026-10-26). Lower it as clones get removed.
    "threshold": 6.9,
    // Tests repeat setup on purpose; duplication there is not worth a shared abstraction.
    "ignore": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.mjs", "src/tests/**", "tests/**"]
  }
}
