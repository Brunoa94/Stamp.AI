# Copy to .env and fill in real values. NEVER prefix a secret with NEXT_PUBLIC_
# — any NEXT_PUBLIC_ value is inlined into the browser bundle and is public.

# --- Site ---
# Public origin of the deployed app (no trailing slash). Also read by
# supabase/config.toml for auth site_url / redirect allow-list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Same origin followed by /** — the glob GoTrue allows /auth/callback?next=...
# redirects to. Read by supabase/config.toml (additional_redirect_urls).
AUTH_ADDITIONAL_REDIRECT_URL=http://localhost:3000/**

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose. Used by server-cache and edge functions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Printify (SERVER-ONLY) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- OpenAI (SERVER-ONLY) ---
OPENAI_API_KEY=

# --- PayPal (SERVER-ONLY secrets) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# --- Credits: price per credit in cents; credit grants derive from paid amount ---
CREDIT_PRICE_CENTS=10

# --- reCAPTCHA v3: protects /api/auth/login, signup and resend-confirmation.
# The secret is verified server-side (src/lib/security/captcha/verify.ts).
# Verification is enforced whenever either value is set, and always in production ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Cache revalidation: long random string ---
REVALIDATION_SECRET=

# --- CORS: comma-separated browser origins allowed to call edge functions ---
ALLOWED_ORIGINS=

# --- Edge function secret (set with `supabase secrets set`, not in Next.js):
# long random string accepted by requireServiceRoleOrCron as an alternative to
# the service-role key for sync-blueprint / sync-cheapest-providers ---
CRON_SECRET=

# --- Operator endpoints (SERVER-ONLY): long random string required as
# `Authorization: Bearer <secret>` on /api/sync-blueprint ---
ADMIN_API_SECRET=
