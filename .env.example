# Copy to .env and fill in real values. NEVER prefix a secret with NEXT_PUBLIC_
# — any NEXT_PUBLIC_ value is inlined into the browser bundle and is public.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose. Used by server-cache and edge functions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Printify (SERVER-ONLY) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- OpenAI (SERVER-ONLY) ---
OPENAI_API_KEY=

# --- PayPal (SERVER-ONLY secrets) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# --- Credits: price per credit in cents; credit grants derive from paid amount ---
CREDIT_PRICE_CENTS=10

# --- Cache revalidation: long random string ---
REVALIDATION_SECRET=

# --- CORS: comma-separated browser origins allowed to call edge functions ---
ALLOWED_ORIGINS=

# --- Sentry (Next.js) ---
# DSN is public by design (it only allows sending events). Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
# Traces sample rate 0..1 (default 0.1). Applies to client, server and edge.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Gate for src/lib/observability/errorCapture (captureError/captureMessage).
NEXT_PUBLIC_ERROR_CAPTURE_ENABLED=true
# Build-time only: lets `next build` upload source maps (CI / Vercel).
SENTRY_AUTH_TOKEN=
# Set automatically by Vercel when "Automatically expose System Environment
# Variables" is on; used for Sentry `environment` and `release`.
# NEXT_PUBLIC_VERCEL_ENV=
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

# --- Sentry (Supabase edge functions; set with `supabase secrets set`) ---
# Separate project from the Next.js app. Unset = reporting disabled (no-op).
SENTRY_DSN=
# Optional overrides; environment is otherwise inferred from DENO_ENV/SUPABASE_URL.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
