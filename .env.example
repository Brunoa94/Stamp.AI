# Copy to .env and fill in real values. NEVER prefix a secret with NEXT_PUBLIC_
# — any NEXT_PUBLIC_ value is inlined into the browser bundle and is public.

# --- Site ---
# Public origin of the deployed app (no trailing slash). Also read by
# supabase/config.toml for auth site_url / redirect allow-list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Same origin followed by /** — the glob GoTrue allows /auth/callback?next=...
# redirects to. Read by supabase/config.toml (additional_redirect_urls).
AUTH_ADDITIONAL_REDIRECT_URL=http://localhost:3000/**

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Base URL of the static image CDN. Defaults to the public static-assets
# bucket of NEXT_PUBLIC_SUPABASE_URL (filled by scripts/push-static-assets.mjs).
NEXT_PUBLIC_STATIC_ASSETS_URL=
# Server-only. Never expose. Used by server-cache and edge functions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Printify (SERVER-ONLY) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# --- Stripe (LIVE credentials) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe (TEST credentials, optional) ---
# Used whenever a request carries `test_mode: true` (checkout in test mode,
# E2E tests) and CHECKOUT_TEST_MODE allows it. If unset, test-mode requests are rejected with
# STRIPE_TEST_SECRET_KEY_MISSING rather than falling back to live keys.
# Register the TEST dashboard webhook at
#   <SUPABASE_URL>/functions/v1/stripe-webhook?mode=test
# and the LIVE dashboard webhook at the same path without `?mode`.
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
# Checkout runs in Stripe test mode unless this is exactly "false". Inlined
# at build time, so a change needs a rebuild/redeploy.
NEXT_PUBLIC_CHECKOUT_TEST_MODE=true
# Server side of the same switch (edge secret, `supabase secrets set`):
# create-payment-intent and create-credit-payment accept `test_mode: true`
# only while this is exactly "true", and reject it with
# STRIPE_TEST_MODE_DISABLED otherwise. Test payments settle as paid, so leave
# it unset in production once live payments are on.
#   Enable test mode:  NEXT_PUBLIC_CHECKOUT_TEST_MODE=true  + CHECKOUT_TEST_MODE=true
#   Go live:           NEXT_PUBLIC_CHECKOUT_TEST_MODE=false + CHECKOUT_TEST_MODE unset
CHECKOUT_TEST_MODE=

# --- OpenAI (SERVER-ONLY) ---
OPENAI_API_KEY=

# --- PayPal (SERVER-ONLY secrets) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# --- Credits: price per credit in cents; credit grants derive from paid amount ---
CREDIT_PRICE_CENTS=10

# --- reCAPTCHA v3: protects /api/auth/login, signup and resend-confirmation.
# The secret is verified server-side (src/lib/security/captcha/verify.ts).
# Verification runs when both keys are set and the request carries a token.
# CAPTCHA_REQUIRED=true also rejects requests without a token (fail closed) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
CAPTCHA_REQUIRED=

# --- Cache revalidation: long random string, sent to POST /api/revalidate?tag=<tag>
# as `Authorization: Bearer <secret>` (no longer accepted in the query string) ---
REVALIDATION_SECRET=

# --- CORS: comma-separated browser origins allowed to call edge functions ---
ALLOWED_ORIGINS=

# --- Edge function secret (set with `supabase secrets set`, not in Next.js):
# long random string accepted by requireServiceRoleOrCron as an alternative to
# the service-role key for sync-blueprint / sync-cheapest-providers ---
CRON_SECRET=

# --- Operator endpoints (SERVER-ONLY): long random string required as
# `Authorization: Bearer <secret>` on /api/sync-blueprint ---
ADMIN_API_SECRET=

# --- Sentry (Next.js): public DSN; Sentry stays off when unset and in development.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE overrides the 0.1 default (0..1) ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# --- Edge function secrets (set with `supabase secrets set`, not in Next.js) ---
# SENTRY_DSN enables error reporting and cron check-ins for edge functions.
# APP_ENV: "test" on the acceptance project; unset/"production" in production
# (a missing Brevo configuration is then reported instead of skipped).
# ORDER_VAT_RATE_BPS: VAT contained in prices, in basis points (default 2100 = 21 %).
# BREVO_API_KEY / BREVO_FROM_EMAIL / BREVO_FROM_NAME: transactional email
# (order confirmation, shipping notification, invoices).
SENTRY_DSN=
APP_ENV=
ORDER_VAT_RATE_BPS=
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
